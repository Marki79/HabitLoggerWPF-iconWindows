<Application x:Class="HabitLoggerWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ThemeMode="System">
    <Application.Resources>

        <!-- Color de acento y margen: se definen una vez y se usan en toda la app -->
        <SolidColorBrush x:Key="ColorAcento" Color="#D63A74" />
        <Thickness x:Key="Margen">8</Thickness>

        <!-- Estilo implícito: se aplica a TODOS los botones -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- Estilo con clave: solo para el botón principal (Style="{StaticResource Primario}") -->
        <Style x:Key="Primario" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource ColorAcento}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

    </Application.Resources>
</Application>
